aws_region          = "ap-south-1"
environment         = "prod"
cluster_version     = "1.34"
admin_principal_arn = "REPLACE_ADMIN_ARN"

# If Jenkins already has an EC2/EKS IAM role, place its ARN here.
# Otherwise Terraform creates project06-prod-jenkins-deployer.
jenkins_principal_arn = ""

# Example: arn:aws:route53:::hostedzone/Z0123456789ABCDEFG
hosted_zone_arn = ""

node_instance_types = ["m7i.large", "m6i.large"]

tags = {
  Owner       = "platform-team"
  CostCenter  = "devops"
  Application = "sample-app"
}

